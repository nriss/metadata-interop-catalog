@startuml flux-alimentation
skinparam shadowing false
skinparam defaultFontSize 12
skinparam nodesep 15
skinparam ranksep 40
scale max 700 width

package "Sources : package-feed.xml (interop.esante.gouv.fr)" as sources {
  rectangle "/package-feed.xml" as feed_root
  rectangle "/ig/package-feed.xml" as feed_ig
  rectangle "/ig/fhir/package-feed.xml" as feed_fhir
  rectangle "/ig/cda/package-feed.xml" as feed_cda
  rectangle "/ig/HL7v2/package-feed.xml" as feed_hl7v2
}

feed_root -[hidden]down-> feed_ig
feed_ig -[hidden]down-> feed_fhir
feed_fhir -[hidden]down-> feed_cda
feed_cda -[hidden]down-> feed_hl7v2

rectangle "IG encapsulant les PDF\ndes specs non encore au format IG\n(solution transitoire,\njusqu'au full IG)" as ig_pdf #fff9e6

rectangle "Outil d'agrégation\n(lecture des flux,\nmapping vers le modèle logique)" as tool

database "Source de vérité\nListe conforme au modèle logique\nSpecificationMetadataList (JSON)" as truth #e8f4f8

rectangle "Site d'affichage des\nspécifications d'interopérabilité" as site

ig_pdf ..> feed_cda : publie un\npackage-feed.xml
feed_root --> tool
feed_ig --> tool
feed_fhir --> tool
feed_cda --> tool
feed_hl7v2 --> tool
tool --> truth : alimente\nautomatiquement
truth --> site : alimente\nautomatiquement
@enduml
